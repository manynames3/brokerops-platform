NODE_ENV=development
PORT=8080
WEB_PORT=3000
DATABASE_URL=postgres://brokerops:brokerops@postgres:5432/brokerops
LOCAL_DATABASE_URL=postgres://brokerops:brokerops@localhost:5432/brokerops
# Hosted demo option:
# NODE_ENV=demo
# DATABASE_URL=postgresql://USER:PASSWORD@EP-NAME-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@EP-NAME.REGION.aws.neon.tech/neondb?sslmode=require
REDIS_URL=redis://redis:6379
LOCAL_REDIS_URL=redis://localhost:6379
AI_PROVIDER=local
AI_MODEL=brokerops-local-rules-v1
API_ALLOWED_ORIGINS=http://localhost:3000,https://brokerops-platform-web.pages.dev
WEB_APP_URL=http://localhost:3000
WORKSPACE_API_KEY=brokerops-local-demo-key
WORKSPACE_NAME=BrokerOps Demo Workspace
AUTH_TOKEN_SECRET=brokerops-local-auth-secret-change-me
AUTH_ADMIN_EMAIL=ops@brokerops.local
AUTH_ADMIN_PASSWORD=brokerops-demo-password
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_DEMO_EMAIL=ops@brokerops.local
NEXT_PUBLIC_WORKSPACE_NAME=BrokerOps Demo Workspace
NEXT_PUBLIC_REQUEST_ACCESS_URL=#pilot
AWS_REGION=us-east-1
OTEL_SERVICE_NAME=brokerops-api
